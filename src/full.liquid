{%- comment -%}
=====================================================================
 Google Calendar fork — per-calendar color coding (TRMNL Plugin Merge)
 Layout: FULL (800x480 / TRMNL X scales)
 View:   3 Day Week TIME GRID — hours down the left axis, one column
         per day, every timed event a SOLID FILLED block spanning its
         duration with the time and title inside it, filled in the
         source calendar's colour. Overlapping blocks cascade to the
         right and overlay each other, as the native render does.
=====================================================================
 SETUP
   1. Connect Google Calendar natively, pick your calendars, hide it in Playlists.
   2. New Private Plugin -> Strategy: Plugin Merge.
   3. Open the "Merge Variables" dropdown, find your node, e.g.
      google_calendar_12345 -> replace the placeholder below.
   4. Fill CAL_MAP with calendar-id=token pairs. Calendar ids are the
      'calname' values in the JSON (usually the calendar's email/id).
      Any calendar you don't list falls back to the FALLBACK cycle.

 TOKENS (framework v3): black, gray-10..gray-75 (steps of 5), white,
   red orange yellow lime green cyan blue violet purple pink,
   or hue-step like blue-40. On 1-bit + TRMNL X grayscale panels,
   hues collapse to their lightness -> keep grays FAR apart
   (black / gray-30 / gray-50 / gray-65) and use glyphs too.

 The axis uses the TIGHT range when every event in the window fits it,
 which buys ~2 more px per hour, and falls back to the WIDE range (the
 native instance's scroll_time..scroll_time_end) only when something
 starts early or runs late. Event times print from ev.start, which the
 native plugin has already formatted with its own time_format.
=====================================================================
{%- endcomment -%}

{%- assign src = google_calendar_12345 -%}
{%- assign CAL_MAP = "you@gmail.com=black,work@google.com=gray-40,abc123@group.calendar.google.com=gray-65" | split: "," -%}
{%- assign FALLBACK = "black,gray-40,gray-65,gray-25,gray-55" | split: "," -%}
{%- assign GLYPHS = "■,●,▲,◆,★,▼,♦,✚" | split: "," -%}
{%- assign SHOW_LEGEND = true -%}
{%- assign SHOW_ALLDAY = true -%}
{%- assign NUM_DAYS = 3 -%}           {%- comment -%} day columns, starting today {%- endcomment -%}
{%- assign TIGHT_START_H = 6 -%}      {%- comment -%} preferred axis when everything fits {%- endcomment -%}
{%- assign TIGHT_END_H = 22 -%}
{%- assign WIDE_START_H = 5 -%}       {%- comment -%} native scroll_time 05:00 {%- endcomment -%}
{%- assign WIDE_END_H = 23 -%}        {%- comment -%} native scroll_time_end 23:00 {%- endcomment -%}
{%- assign HOUR_EVERY = 1 -%}         {%- comment -%} label every Nth hour {%- endcomment -%}
{%- assign AXIS_W = 40 -%}       {%- comment -%} fits "12pm" at the label font {%- endcomment -%}
{%- assign LIGHT_TOKENS = "white,yellow,lime,cyan,gray-10,gray-15,gray-20,gray-25,gray-30,gray-35,gray-40,gray-45" | split: "," -%}
                                      {%- comment -%} fills that need dark text. Mid greys dither on a
                                          1-bit panel, where white text disappears into the pattern. {%- endcomment -%}
{%- assign LINE_H = 12 -%}            {%- comment -%} one line of block text {%- endcomment -%}
{%- assign HOUR_H = 24 -%}            {%- comment -%} px per hour. Two lines per hour, so a 30-minute
                                          block still clears one line of text. {%- endcomment -%}
{%- assign LANE_OFFSET = 22 -%}       {%- comment -%} % each lane is nudged right; blocks overlay rather
                                          than divide the width, the way the native render does {%- endcomment -%}
{%- assign MAX_LANES = 3 -%}          {%- comment -%} lane 2 still leaves 56% width {%- endcomment -%}
{%- assign DAY_FMT = "%a %-m/%-d" -%} {%- comment -%} native date_format: short {%- endcomment -%}
{%- assign HIGHLIGHT_TODAY = true -%}
{%- assign SHADE_WEEKENDS = true -%}
{%- assign VIEW = "full" -%}          {%- comment -%} full | half_horizontal | half_vertical | quadrant {%- endcomment -%}
{%- assign HEAD_SIZE = "small" -%}
{%- assign MIN_BLOCK_H = 14 -%}       {%- comment -%} one text line plus its border {%- endcomment -%}

{%- comment -%} ---- derived: resolve one token + glyph per calendar, once ---- {%- endcomment -%}
{%- assign events = src.events | sort: "start_full" -%}
{%- assign names = src.calendar_names -%}
{%- assign today = src.today_in_tz | split: "T" | first -%}
{%- assign today_ts = today | date: "%s" | times: 1 -%}
{%- assign last_off = NUM_DAYS | minus: 1 | times: 86400 -%}
{%- assign last_day = today_ts | plus: last_off | date: "%Y-%m-%d" -%}
{%- assign cals = events | map: "calname" | uniq -%}

{%- assign mapped = "" -%}
{%- for pair in CAL_MAP -%}{%- assign kv = pair | split: "=" -%}{%- assign mapped = mapped | append: "|" | append: kv[1] | append: "|" -%}{%- endfor -%}
{%- assign fb = "" -%}
{%- for f in FALLBACK -%}{%- assign needle = "|" | append: f | append: "|" -%}{%- unless mapped contains needle -%}{%- assign fb = fb | append: f | append: "," -%}{%- endunless -%}{%- endfor -%}
{%- assign FB = fb | split: "," -%}
{%- if FB.size == 0 -%}{%- assign FB = FALLBACK -%}{%- endif -%}

{%- assign tokens_s = "" -%}
{%- assign fbi = 0 -%}
{%- for c in cals -%}
  {%- assign t = "" -%}
  {%- for pair in CAL_MAP -%}{%- assign kv = pair | split: "=" -%}{%- if kv[0] == c -%}{%- assign t = kv[1] -%}{%- break -%}{%- endif -%}{%- endfor -%}
  {%- if t == "" -%}{%- assign i = fbi | modulo: FB.size -%}{%- assign t = FB[i] -%}{%- assign fbi = fbi | plus: 1 -%}{%- endif -%}
  {%- assign tokens_s = tokens_s | append: t | append: "," -%}
{%- endfor -%}
{%- assign CAL_TOKENS = tokens_s | split: "," -%}

{%- comment -%} contrasting text colour for each fill {%- endcomment -%}
{%- assign texts_s = "" -%}
{%- for t in CAL_TOKENS -%}
  {%- assign txt = "white" -%}
  {%- for lt in LIGHT_TOKENS -%}{%- if lt == t -%}{%- assign txt = "black" -%}{%- break -%}{%- endif -%}{%- endfor -%}
  {%- assign texts_s = texts_s | append: txt | append: "," -%}
{%- endfor -%}
{%- assign CAL_TEXTS = texts_s | split: "," -%}

{%- comment -%}
  ---- pick the axis range: tight unless something in the window falls
  outside it. Scanning once here keeps the decision identical for the
  axis, the hour rules and every block.
{%- endcomment -%}
{%- assign win_min = 9999 -%}
{%- assign win_max = 0 -%}
{%- for ev in events -%}
  {%- if ev.all_day -%}{%- continue -%}{%- endif -%}
  {%- assign d = ev.start_full | split: "T" | first -%}
  {%- if d < today or d > last_day -%}{%- continue -%}{%- endif -%}
  {%- assign tb = ev.start_full | split: "T" | last | split: ":" -%}
  {%- assign s1 = tb[0] | times: 60 | plus: tb[1] -%}
  {%- assign te = ev.end_full | split: "T" | last | split: ":" -%}
  {%- if ev.end_full == blank -%}{%- assign e1 = s1 | plus: 60 -%}{%- else -%}{%- assign e1 = te[0] | times: 60 | plus: te[1] -%}{%- endif -%}
  {%- if s1 < win_min -%}{%- assign win_min = s1 -%}{%- endif -%}
  {%- if e1 > win_max -%}{%- assign win_max = e1 -%}{%- endif -%}
{%- endfor -%}
{%- assign TIGHT_S = TIGHT_START_H | times: 60 -%}
{%- assign TIGHT_E = TIGHT_END_H | times: 60 -%}
{%- assign GRID_START_H = WIDE_START_H -%}
{%- assign GRID_END_H = WIDE_END_H -%}
{%- if win_min >= TIGHT_S and win_max <= TIGHT_E -%}
  {%- assign GRID_START_H = TIGHT_START_H -%}
  {%- assign GRID_END_H = TIGHT_END_H -%}
{%- endif -%}
{%- assign START_MIN = GRID_START_H | times: 60 -%}
{%- assign END_MIN = GRID_END_H | times: 60 -%}
{%- assign SPAN_MIN = END_MIN | minus: START_MIN -%}
{%- assign HOURS = GRID_END_H | minus: GRID_START_H -%}
{%- assign GRID_H = HOUR_H | times: HOURS -%}

<style>
  /* Framework utility classes carry padding, text alignment and fills so
     this block stays clear of the properties trmnlp's lint counts. */
  .cg-wrap { display: flex; flex-direction: column; width: 100%; }
  .cg-row { display: flex; }
  .cg-row--head { align-items: flex-end; }
  .cg-axis { flex: 0 0 var(--cg-axis-w); width: var(--cg-axis-w); }
  .cg-day { flex: 1 1 0; min-width: 0; }
  .cg-allday { border-bottom: 1px solid currentColor; align-items: stretch; }
  .cg-allday .cg-day { border-left: 1px solid currentColor; }
  .cg-axis--label { display: flex; align-items: center; }
  /* The grid may be taller than the panel; clip at the bottom the way
     the native render does rather than shrink the text. */
  .cg-grid { display: flex; height: var(--cg-grid-h); flex: 0 0 var(--cg-grid-h); }
  .cg-wrap { overflow: hidden; }
  .cg-axis--hours { display: flex; flex-direction: column; }
  /* Pinned, not flexed: a flex axis compresses when the view is shorter
     than the grid, and then the labels no longer line up with the hour
     rules, which are drawn at a fixed pixel pitch. */
  .cg-hour {
    flex: 0 0 var(--cg-hour-h); height: var(--cg-hour-h);
    line-height: 1; white-space: nowrap; overflow: visible;
  }
  .cg-col {
    flex: 1 1 0; min-width: 0; position: relative;
    border-left: 1px solid currentColor;
    background-image: repeating-linear-gradient(
      to bottom, #999 0, #999 1px, transparent 1px, transparent var(--cg-hour-h));
  }
  /* A solid filled block spanning the event's duration, text inside.
     Later blocks in a cluster cascade right and paint OVER earlier ones
     (DOM order), the way the native render stacks them, so a block keeps
     a usable width instead of being divided into slivers. The white
     border is what separates two overlapping fills. */
  .cg-block {
    position: absolute; box-sizing: border-box; overflow: hidden;
    border: 1px solid #fff; right: 0;
  }
  .cg-line {
    display: block; white-space: nowrap; overflow: hidden;
    text-overflow: ellipsis; line-height: var(--cg-line-h);
  }
  .cg-adbar { overflow: hidden; border: 1px solid #fff; }
</style>

<div class="view view--{{ VIEW }}">
  <div class="layout">
    <div class="cg-wrap" style="--cg-axis-w:{{ AXIS_W }}px;--cg-grid-h:{{ GRID_H }}px;--cg-hour-h:{{ HOUR_H }}px;--cg-line-h:{{ LINE_H }}px">

      {%- comment -%} ---------- day header row ---------- {%- endcomment -%}
      <div class="cg-row cg-row--head">
        <div class="cg-axis"></div>
        {%- for n in (1..NUM_DAYS) -%}
          {%- assign offset = n | minus: 1 | times: 86400 -%}
          {%- assign day_ts = today_ts | plus: offset -%}
          {%- assign day_key = day_ts | date: "%Y-%m-%d" -%}
          {%- assign day_label = day_ts | date: DAY_FMT -%}
          <div class="cg-day text--center px--1" data-day-col="{{ day_key }}">
            {%- if day_key == today and HIGHLIGHT_TODAY -%}
              <span class="label label--{{ HEAD_SIZE }} label--filled" data-day-header="true">{{ day_label }}</span>
            {%- else -%}
              <span class="label label--{{ HEAD_SIZE }}" data-day-header="true">{{ day_label }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} ---------- all-day band ---------- {%- endcomment -%}
      {%- if SHOW_ALLDAY -%}
        <div class="cg-row cg-allday">
          <div class="cg-axis cg-axis--label">
            <span class="label label--xsmall text--gray-45">all day</span>
          </div>
          {%- for n in (1..NUM_DAYS) -%}
            {%- assign offset = n | minus: 1 | times: 86400 -%}
            {%- assign day_ts = today_ts | plus: offset -%}
            {%- assign day_key = day_ts | date: "%Y-%m-%d" -%}
            <div class="cg-day px--1">
              {%- for ev in events -%}
                {%- unless ev.all_day -%}{%- continue -%}{%- endunless -%}
                {%- assign ev_s = ev.start_full | split: "T" | first -%}
                {%- assign ev_e = ev.end_full | split: "T" | first -%}
                {%- assign on_day = false -%}
                {%- if ev_e == blank or ev_e <= ev_s -%}
                  {%- if day_key == ev_s -%}{%- assign on_day = true -%}{%- endif -%}
                {%- elsif day_key >= ev_s and day_key < ev_e -%}
                  {%- assign on_day = true -%}
                {%- endif -%}
                {%- unless on_day -%}{%- continue -%}{%- endunless -%}
                {%- assign ci = 0 -%}
                {%- for c in cals -%}{%- if c == ev.calname -%}{%- assign ci = forloop.index0 -%}{%- break -%}{%- endif -%}{%- endfor -%}
                {%- assign token = CAL_TOKENS[ci] -%}
                {%- assign gi = ci | modulo: GLYPHS.size -%}
                {%- assign txt = CAL_TEXTS[ci] -%}
                <div class="cg-adbar bg--{{ token }} rounded--small" data-allday="true">
                  <span class="label label--xsmall cg-line text--{{ txt }}">{{ ev.summary }}</span>
                </div>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} ---------- hour grid ---------- {%- endcomment -%}
      <div class="cg-row cg-grid">

        <div class="cg-axis cg-axis--hours">
          {%- for h in (GRID_START_H..GRID_END_H) -%}
            {%- if forloop.last -%}{%- break -%}{%- endif -%}
            {%- assign hoff = h | minus: GRID_START_H -%}
            {%- assign hmod = hoff | modulo: HOUR_EVERY -%}
            <div class="cg-hour text--right px--1">
              {%- if hmod == 0 -%}
                {%- assign h12 = h | modulo: 12 -%}
                {%- if h12 == 0 -%}{%- assign h12 = 12 -%}{%- endif -%}
                {%- if h < 12 -%}{%- assign ap = "am" -%}{%- else -%}{%- assign ap = "pm" -%}{%- endif -%}
                <span class="label label--xsmall text--gray-45" data-hour="{{ h }}">{{ h12 }}{{ ap }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- for n in (1..NUM_DAYS) -%}
          {%- assign offset = n | minus: 1 | times: 86400 -%}
          {%- assign day_ts = today_ts | plus: offset -%}
          {%- assign day_key = day_ts | date: "%Y-%m-%d" -%}
          {%- assign dow = day_ts | date: "%w" -%}
          {%- assign weekend = false -%}
          {%- if dow == "0" or dow == "6" -%}{%- assign weekend = true -%}{%- endif -%}

          {%- comment -%}
            Pass 1 — interval sweep over the day, in start order.

            lane_ends holds the end minute of each open lane; an event
            takes the LOWEST lane already free at its start, so lanes are
            reused and duration bars never overlap. lane_free holds each
            lane's next free TEXT y: an entry is anchored at its start
            time unless the previous entry in that lane still occupies
            that line, in which case it is pushed to the first free line
            below — the native plugin's stacked
            "9:00 AM Busy / 9:45 AM Busy" behaviour.

            A cluster closes when an event starts at or after every open
            lane's end. Only MAX_LANES lanes are drawn; the rest are
            counted into the cluster's "+N" marker.

            recs entries are "index:lane:texty:cluster", clusters are
            "cluster:lanes:overflow:top".
          {%- endcomment -%}
          {%- assign recs = "" -%}
          {%- assign clusters = "" -%}
          {%- assign lane_ends = "" -%}
          {%- assign lane_free = "" -%}
          {%- assign cluster_id = 0 -%}
          {%- assign cluster_max_end = 0 -%}
          {%- assign cluster_lanes = 0 -%}
          {%- assign cluster_over = 0 -%}
          {%- assign cluster_top = 0 -%}
          {%- assign started = false -%}
          {%- for ev in events -%}
            {%- if ev.all_day -%}{%- continue -%}{%- endif -%}
            {%- assign ev_day = ev.start_full | split: "T" | first -%}
            {%- unless ev_day == day_key -%}{%- continue -%}{%- endunless -%}
            {%- assign idx = forloop.index0 -%}
            {%- assign tb = ev.start_full | split: "T" | last | split: ":" -%}
            {%- assign s1 = tb[0] | times: 60 | plus: tb[1] -%}
            {%- assign te = ev.end_full | split: "T" | last | split: ":" -%}
            {%- if ev.end_full == blank -%}{%- assign e1 = s1 | plus: 60 -%}{%- else -%}{%- assign e1 = te[0] | times: 60 | plus: te[1] -%}{%- endif -%}
            {%- if e1 <= s1 -%}{%- assign e1 = s1 | plus: 30 -%}{%- endif -%}
            {%- assign vs = s1 -%}{%- if vs < START_MIN -%}{%- assign vs = START_MIN -%}{%- endif -%}
            {%- if vs >= END_MIN -%}{%- continue -%}{%- endif -%}
            {%- assign top = vs | minus: START_MIN | times: GRID_H | divided_by: SPAN_MIN -%}

            {%- if started and s1 >= cluster_max_end -%}
              {%- assign clusters = clusters | append: cluster_id | append: ":" | append: cluster_lanes | append: ":" | append: cluster_over | append: ":" | append: cluster_top | append: "," -%}
              {%- assign cluster_id = cluster_id | plus: 1 -%}
              {%- assign lane_ends = "" -%}
              {%- assign cluster_lanes = 0 -%}
              {%- assign cluster_over = 0 -%}
              {%- assign cluster_max_end = 0 -%}
              {%- assign cluster_top = top -%}
            {%- endif -%}
            {%- unless started -%}{%- assign cluster_top = top -%}{%- endunless -%}
            {%- assign started = true -%}

            {%- assign LE = lane_ends | split: "," -%}
            {%- assign LF = lane_free | split: "," -%}
            {%- assign chosen = -1 -%}
            {%- for le in LE -%}
              {%- assign lev = le | times: 1 -%}
              {%- if chosen == -1 and lev <= s1 -%}{%- assign chosen = forloop.index0 -%}{%- endif -%}
            {%- endfor -%}
            {%- if chosen == -1 -%}
              {%- assign chosen = LE.size -%}
              {%- assign lane_ends = lane_ends | append: e1 | append: "," -%}
            {%- else -%}
              {%- assign nl = "" -%}
              {%- for le in LE -%}
                {%- if forloop.index0 == chosen -%}{%- assign nl = nl | append: e1 | append: "," -%}
                {%- else -%}{%- assign nl = nl | append: le | append: "," -%}{%- endif -%}
              {%- endfor -%}
              {%- assign lane_ends = nl -%}
            {%- endif -%}

            {%- assign used = chosen | plus: 1 -%}
            {%- if used > cluster_lanes -%}{%- assign cluster_lanes = used -%}{%- endif -%}
            {%- if e1 > cluster_max_end -%}{%- assign cluster_max_end = e1 -%}{%- endif -%}

            {%- comment -%}
              lane_free is a COLUMN-wide text cursor per lane, not a
              per-cluster one: a cluster boundary resets lane assignment
              but text must still not land on the line above it.
            {%- endcomment -%}
            {%- assign need_lf = chosen | plus: 1 -%}
            {%- for pad in (1..need_lf) -%}
              {%- assign LF = lane_free | split: "," -%}
              {%- if LF.size >= need_lf -%}{%- break -%}{%- endif -%}
              {%- assign lane_free = lane_free | append: "0," -%}
            {%- endfor -%}
            {%- assign LF = lane_free | split: "," -%}

            {%- if chosen >= MAX_LANES -%}
              {%- assign cluster_over = cluster_over | plus: 1 -%}
              {%- assign recs = recs | append: idx | append: ":-1:0:" | append: cluster_id | append: "," -%}
            {%- else -%}
              {%- assign fy = LF[chosen] | times: 1 -%}
              {%- assign ty = top -%}
              {%- if fy > ty -%}{%- assign ty = fy -%}{%- endif -%}
              {%- assign nf = "" -%}
              {%- for f in LF -%}
                {%- if forloop.index0 == chosen -%}
                  {%- assign adv = ty | plus: LINE_H -%}
                  {%- assign nf = nf | append: adv | append: "," -%}
                {%- else -%}{%- assign nf = nf | append: f | append: "," -%}{%- endif -%}
              {%- endfor -%}
              {%- assign lane_free = nf -%}
              {%- assign recs = recs | append: idx | append: ":" | append: chosen | append: ":" | append: ty | append: ":" | append: cluster_id | append: "," -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if started -%}
            {%- assign clusters = clusters | append: cluster_id | append: ":" | append: cluster_lanes | append: ":" | append: cluster_over | append: ":" | append: cluster_top | append: "," -%}
          {%- endif -%}
          {%- assign RECS = recs | split: "," -%}
          {%- assign CLUS = clusters | split: "," -%}

          <div class="cg-col{% if weekend and SHADE_WEEKENDS %} bg--gray-10{% endif %}" data-grid-col="{{ day_key }}">
            {%- comment -%} Pass 2 — draw each event's bar and its text entry. {%- endcomment -%}
            {%- for ev in events -%}
              {%- if ev.all_day -%}{%- continue -%}{%- endif -%}
              {%- assign ev_day = ev.start_full | split: "T" | first -%}
              {%- unless ev_day == day_key -%}{%- continue -%}{%- endunless -%}
              {%- assign idx = forloop.index0 -%}

              {%- assign lane = -1 -%}
              {%- assign ty = 0 -%}
              {%- assign myclus = 0 -%}
              {%- assign seen = false -%}
              {%- for r in RECS -%}
                {%- assign rp = r | split: ":" -%}
                {%- assign ri = rp[0] | times: 1 -%}
                {%- if ri == idx -%}
                  {%- assign lane = rp[1] | times: 1 -%}
                  {%- assign ty = rp[2] | times: 1 -%}
                  {%- assign myclus = rp[3] | times: 1 -%}
                  {%- assign seen = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              {%- unless seen -%}{%- continue -%}{%- endunless -%}
              {%- if lane < 0 -%}{%- continue -%}{%- endif -%}

              {%- assign tb = ev.start_full | split: "T" | last | split: ":" -%}
              {%- assign s1 = tb[0] | times: 60 | plus: tb[1] -%}
              {%- assign te = ev.end_full | split: "T" | last | split: ":" -%}
              {%- if ev.end_full == blank -%}{%- assign e1 = s1 | plus: 60 -%}{%- else -%}{%- assign e1 = te[0] | times: 60 | plus: te[1] -%}{%- endif -%}
              {%- if e1 <= s1 -%}{%- assign e1 = s1 | plus: 30 -%}{%- endif -%}
              {%- assign vs = s1 -%}{%- if vs < START_MIN -%}{%- assign vs = START_MIN -%}{%- endif -%}
              {%- assign ve = e1 -%}{%- if ve > END_MIN -%}{%- assign ve = END_MIN -%}{%- endif -%}
              {%- if ve <= START_MIN or vs >= END_MIN -%}{%- continue -%}{%- endif -%}
              {%- assign top = vs | minus: START_MIN | times: GRID_H | divided_by: SPAN_MIN -%}
              {%- assign hgt = ve | minus: vs | times: GRID_H | divided_by: SPAN_MIN -%}
              {%- comment -%}
                A block never shrinks below one line of text; the native
                render does the same, letting a short event overlap the
                one after it rather than become unreadable.
              {%- endcomment -%}
              {%- if hgt < MIN_BLOCK_H -%}{%- assign hgt = MIN_BLOCK_H -%}{%- endif -%}
              {%- assign lane_l = lane | times: LANE_OFFSET -%}

              {%- assign ci = 0 -%}
              {%- for c in cals -%}{%- if c == ev.calname -%}{%- assign ci = forloop.index0 -%}{%- break -%}{%- endif -%}{%- endfor -%}
              {%- assign token = CAL_TOKENS[ci] -%}
              {%- assign gi = ci | modulo: GLYPHS.size -%}

              {%- assign txt = CAL_TEXTS[ci] -%}
              {%- assign two_line_h = LINE_H | times: 2 | plus: 2 -%}
              {%- if hgt >= two_line_h -%}{%- assign lines = 2 -%}{%- else -%}{%- assign lines = 1 -%}{%- endif -%}
              <div class="cg-block bg--{{ token }} rounded--small" style="top:{{ top }}px;height:{{ hgt }}px;left:{{ lane_l }}%" data-block="{{ top }},{{ hgt }},{{ lane_l }},{{ lines }},{{ LINE_H }}">
                {%- if lines == 2 -%}
                  <span class="label label--xsmall cg-line text--{{ txt }}">{{ ev.start }} - {{ ev.end }}</span>
                  <span class="label label--xsmall cg-line text--{{ txt }}">{{ ev.summary }}</span>
                {%- else -%}
                  <span class="label label--xsmall cg-line text--{{ txt }}">{{ ev.start }} - {{ ev.end }} - {{ ev.summary }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}

            {%- comment -%} "+N" for events beyond MAX_LANES {%- endcomment -%}
            {%- for cpair in CLUS -%}
              {%- assign cp = cpair | split: ":" -%}
              {%- assign cov = cp[2] | times: 1 -%}
              {%- if cov > 0 -%}
                {%- assign ctop = cp[3] | times: 1 -%}
                <div class="cg-more" style="top:{{ ctop }}px" data-more="{{ cov }}">
                  <span class="label label--xsmall text--gray-45">+{{ cov }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="title_bar">
    <img class="image" src="https://usetrmnl.com/images/plugins/google_calendar--render.svg">
    <span class="title">{{ src.instance_name | default: "Calendar" }}</span>
    {%- if SHOW_LEGEND -%}
      <span class="instance">
        {%- for c in cals -%}
          {%- assign token = CAL_TOKENS[forloop.index0] -%}
          {%- assign gi = forloop.index0 | modulo: GLYPHS.size -%}
          {%- assign label = names[c] | default: c | split: "@" | first -%}
          <span class="text--{{ token }}">{{ GLYPHS[gi] }}</span>&nbsp;{{ label }}{% unless forloop.last %}&nbsp;&nbsp;{% endunless %}
        {%- endfor -%}
      </span>
    {%- endif -%}
  </div>
</div>
