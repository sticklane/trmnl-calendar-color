{%- comment -%}
=====================================================================
 Google Calendar fork — per-calendar color coding (TRMNL Plugin Merge)
 Layout: FULL (800x480 / TRMNL X scales)
 View:   3-day week — one column per day, matching the native plugin's
         "3 Day Week" event layout rather than a day-grouped agenda.
=====================================================================
 SETUP
   1. Connect Google Calendar natively, pick your calendars, hide it in Playlists.
   2. New Private Plugin -> Strategy: Plugin Merge.
   3. Open the "Merge Variables" dropdown, find your node, e.g.
      google_calendar_12345 -> replace the placeholder below.
   4. Fill CAL_MAP with calendar-id=token pairs. Calendar ids are the
      'calname' values in the JSON (usually the calendar's email/id).
      Any calendar you don't list falls back to the FALLBACK cycle.

 TOKENS (framework v3): black, gray-10..gray-75 (steps of 5), white,
   red orange yellow lime green cyan blue violet purple pink,
   or hue-step like blue-40. On 1-bit + TRMNL X grayscale panels,
   hues collapse to their lightness -> keep grays FAR apart
   (black / gray-30 / gray-50 / gray-65) and use glyphs too.

 Event times come straight from ev.start / ev.end, which the native
 plugin has already formatted with its own time_format setting, so the
 clock style always matches the native instance without a knob here.
=====================================================================
{%- endcomment -%}

{%- assign src = google_calendar_12345 -%}
{%- assign CAL_MAP = "you@gmail.com=black,work@google.com=gray-40,abc123@group.calendar.google.com=gray-65" | split: "," -%}
{%- assign FALLBACK = "black,gray-40,gray-65,gray-25,gray-55" | split: "," -%}
{%- assign GLYPHS = "■,●,▲,◆,★,▼,♦,✚" | split: "," -%}
{%- assign MODE = "both" -%}            {%- comment -%} bar | glyph | both {%- endcomment -%}
{%- assign SHOW_LEGEND = true -%}
{%- assign SHOW_TIME = true -%}
{%- assign SHOW_DESC = true -%}
{%- assign NUM_DAYS = 3 -%}           {%- comment -%} day columns, starting today {%- endcomment -%}
{%- assign DAY_FMT = "%a %-m/%-d" -%} {%- comment -%} localized short, e.g. Mon 9/8 {%- endcomment -%}
{%- assign HIGHLIGHT_TODAY = true -%}
{%- assign SHADE_WEEKENDS = true -%}
{%- assign MAX_PER_DAY = 0 -%}        {%- comment -%} 0 = uncapped {%- endcomment -%}
{%- assign VIEW = "full" -%}          {%- comment -%} full | half_horizontal | half_vertical | quadrant {%- endcomment -%}
{%- assign HEAD_SIZE = "small" -%}
{%- assign TITLE_SIZE = "small" -%}
{%- assign BAR_WIDTH = 8 -%}          {%- comment -%} px. OG 1-bit: keep >= 12 so dither patterns read {%- endcomment -%}

{%- comment -%} ---- derived: resolve one token + glyph per calendar, once ---- {%- endcomment -%}
{%- assign events = src.events | sort: "start_full" -%}
{%- assign names = src.calendar_names -%}
{%- assign today = src.today_in_tz | split: "T" | first -%}
{%- assign today_ts = today | date: "%s" | times: 1 -%}
{%- assign cals = events | map: "calname" | uniq -%}

{%- assign mapped = "" -%}
{%- for pair in CAL_MAP -%}{%- assign kv = pair | split: "=" -%}{%- assign mapped = mapped | append: "|" | append: kv[1] | append: "|" -%}{%- endfor -%}
{%- assign fb = "" -%}
{%- for f in FALLBACK -%}{%- assign needle = "|" | append: f | append: "|" -%}{%- unless mapped contains needle -%}{%- assign fb = fb | append: f | append: "," -%}{%- endunless -%}{%- endfor -%}
{%- assign FB = fb | split: "," -%}
{%- if FB.size == 0 -%}{%- assign FB = FALLBACK -%}{%- endif -%}

{%- assign tokens_s = "" -%}
{%- assign fbi = 0 -%}
{%- for c in cals -%}
  {%- assign t = "" -%}
  {%- for pair in CAL_MAP -%}{%- assign kv = pair | split: "=" -%}{%- if kv[0] == c -%}{%- assign t = kv[1] -%}{%- break -%}{%- endif -%}{%- endfor -%}
  {%- if t == "" -%}{%- assign i = fbi | modulo: FB.size -%}{%- assign t = FB[i] -%}{%- assign fbi = fbi | plus: 1 -%}{%- endif -%}
  {%- assign tokens_s = tokens_s | append: t | append: "," -%}
{%- endfor -%}
{%- assign CAL_TOKENS = tokens_s | split: "," -%}

<div class="view view--{{ VIEW }}">
  <div class="layout">
    <div class="columns">
      {%- for n in (1..NUM_DAYS) -%}
        {%- assign offset = n | minus: 1 | times: 86400 -%}
        {%- assign day_ts = today_ts | plus: offset -%}
        {%- assign day_key = day_ts | date: "%Y-%m-%d" -%}
        {%- assign day_label = day_ts | date: DAY_FMT -%}
        {%- assign dow = day_ts | date: "%w" -%}
        {%- assign weekend = false -%}
        {%- if dow == "0" or dow == "6" -%}{%- assign weekend = true -%}{%- endif -%}

        <div class="column" data-day-col="{{ day_key }}">
          {%- if day_key == today and HIGHLIGHT_TODAY -%}
            <span class="label label--{{ HEAD_SIZE }} label--filled" data-day-header="true">{{ day_label }}</span>
          {%- elsif weekend and SHADE_WEEKENDS -%}
            <span class="label label--{{ HEAD_SIZE }} label--underline text--gray-45" data-day-header="true">{{ day_label }}</span>
          {%- else -%}
            <span class="label label--{{ HEAD_SIZE }}" data-day-header="true">{{ day_label }}</span>
          {%- endif -%}

          {%- comment -%}
            All-day rows lead the column. A bare YYYY-MM-DD start_full
            sorts ahead of the same day's timed events, so the global
            sort already puts them first; this pass just keeps them
            grouped when a multi-day event started on an earlier day.
          {%- endcomment -%}
          {%- assign shown = 0 -%}
          {%- for pass in (1..2) -%}
            {%- for ev in events -%}
              {%- if MAX_PER_DAY > 0 and shown >= MAX_PER_DAY -%}{%- break -%}{%- endif -%}
              {%- if pass == 1 and ev.all_day != true -%}{%- continue -%}{%- endif -%}
              {%- if pass == 2 and ev.all_day -%}{%- continue -%}{%- endif -%}

              {%- assign ev_start_day = ev.start_full | split: "T" | first -%}
              {%- assign on_day = false -%}
              {%- if ev.all_day -%}
                {%- comment -%}
                  Google's all-day end date is exclusive, so a one-day
                  event has end == start + 1. Treat a missing or
                  non-advancing end as a single day rather than dropping
                  the event entirely.
                {%- endcomment -%}
                {%- assign ev_end_day = ev.end_full | split: "T" | first -%}
                {%- if ev_end_day == blank or ev_end_day <= ev_start_day -%}
                  {%- if day_key == ev_start_day -%}{%- assign on_day = true -%}{%- endif -%}
                {%- elsif day_key >= ev_start_day and day_key < ev_end_day -%}
                  {%- assign on_day = true -%}
                {%- endif -%}
              {%- elsif day_key == ev_start_day -%}
                {%- assign on_day = true -%}
              {%- endif -%}
              {%- unless on_day -%}{%- continue -%}{%- endunless -%}

              {%- assign ci = 0 -%}
              {%- for c in cals -%}{%- if c == ev.calname -%}{%- assign ci = forloop.index0 -%}{%- break -%}{%- endif -%}{%- endfor -%}
              {%- assign token = CAL_TOKENS[ci] -%}
              {%- assign gi = ci | modulo: GLYPHS.size -%}
              {%- assign glyph = GLYPHS[gi] -%}
              {%- assign shown = shown | plus: 1 -%}

              <div class="item" data-event="true">
                {%- if MODE == "bar" or MODE == "both" -%}
                  <div class="bg--{{ token }} rounded--small" style="width:{{ BAR_WIDTH }}px;align-self:stretch;flex-shrink:0"></div>
                {%- endif -%}
                {%- if MODE == "glyph" or MODE == "both" -%}
                  <div class="meta"><span class="index text--{{ token }}">{{ glyph }}</span></div>
                {%- endif -%}
                <div class="content">
                  <span class="title title--{{ TITLE_SIZE }}" data-clamp="2">{{ ev.summary }}</span>
                  {%- if SHOW_TIME -%}
                    {%- if ev.all_day -%}
                      <span class="label label--small label--underline">All day</span>
                    {%- else -%}
                      <span class="label label--small label--underline">{{ ev.start }} – {{ ev.end }}</span>
                    {%- endif -%}
                  {%- endif -%}
                  {%- if SHOW_DESC and ev.description != blank -%}
                    <span class="description" data-clamp="1">{{ ev.description }}</span>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endfor -%}

          {%- if shown == 0 -%}
            <span class="label label--small text--gray-45">—</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="title_bar">
    <img class="image" src="https://usetrmnl.com/images/plugins/google_calendar--render.svg">
    <span class="title">{{ src.instance_name | default: "Calendar" }}</span>
    {%- if SHOW_LEGEND -%}
      <span class="instance">
        {%- for c in cals -%}
          {%- assign token = CAL_TOKENS[forloop.index0] -%}
          {%- assign gi = forloop.index0 | modulo: GLYPHS.size -%}
          {%- assign label = names[c] | default: c | split: "@" | first -%}
          <span class="text--{{ token }}">{{ GLYPHS[gi] }}</span>&nbsp;{{ label }}{% unless forloop.last %}&nbsp;&nbsp;{% endunless %}
        {%- endfor -%}
      </span>
    {%- endif -%}
  </div>
</div>
