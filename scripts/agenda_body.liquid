{%- comment -%}
  ---------------- agenda view ----------------
  One-off events from the agenda calendars, one line each, grouped under
  month headers, as far ahead as the source reaches. A wide panel splits
  the list into two columns balanced by count; a narrow one has one. Rows
  and headers are placed top-down against the usable height less one
  footer line; what does not fit is counted into "+N more". Black and
  white only, plus the calendar's own token on the swatch, so it reads on
  a 1-bit panel too.
{%- endcomment -%}
{%- assign AG_RAW = CF.agenda_calendars | default: agenda_calendars | default: "" | strip | replace: ",", "
" -%}
{%- assign AG_LIST = AG_RAW | split: "
" -%}
{%- comment -%} a tall panel can afford a looser pitch; a short one packs its rows {%- endcomment -%}
{%- if PANEL_H > 300 -%}{%- assign AG_ROW_H = LINE_H | plus: 6 -%}{%- else -%}{%- assign AG_ROW_H = LINE_H | plus: 2 -%}{%- endif -%}
{%- assign AG_HEAD_H = LINE_H | plus: 4 -%}
{%- assign AG_GAP_H = 4 -%}
{%- assign AG_BUDGET = PANEL_H | minus: AG_ROW_H -%}
{%- if PANEL_W >= 700 -%}{%- assign AG_COLS = 2 -%}{%- else -%}{%- assign AG_COLS = 1 -%}{%- endif -%}
{%- assign AG_GUTTER = 12 -%}
{%- assign AG_COL_W = PANEL_W | minus: AG_GUTTER | divided_by: AG_COLS -%}
{%- if AG_COLS == 1 -%}{%- assign AG_COL_W = PANEL_W -%}{%- endif -%}
{%- assign AG_DATE_CHARS = 11 -%}   {%- comment -%} "10/15-10/18", the widest a span gets {%- endcomment -%}
{%- assign AG_TIME_CHARS = 7 -%}
{%- assign AG_ROW_CHARS = AG_COL_W | times: 100 | divided_by: CHAR_W100 | minus: 3 -%}
{%- comment -%} the text cell is the column less the swatch, the two fixed cells and their spacing {%- endcomment -%}
{%- assign AG_DATE_PX = AG_DATE_CHARS | times: CHAR_W100 | divided_by: 100 | plus: 4 -%}
{%- assign AG_TIME_PX = AG_TIME_CHARS | times: CHAR_W100 | divided_by: 100 | plus: 4 -%}
{%- assign AG_TITLE_CHARS = AG_COL_W | minus: AG_DATE_PX | minus: AG_TIME_PX | minus: 22 | times: 100 | divided_by: CHAR_W100 -%}
{%- assign HORIZON_LAST = today_ts | plus: 3542400 | date: "%b %-d" -%}

{%- comment -%} pass 1: how many events the list holds, so two columns can split them evenly {%- endcomment -%}
{%- assign n_inc = 0 -%}
{%- for ev in events -%}
  {%- assign ci = 0 -%}
  {%- for c in cals -%}{%- if c == ev.calname -%}{%- assign ci = forloop.index0 -%}{%- break -%}{%- endif -%}{%- endfor -%}
  {%- assign keep = false -%}
  {%- if AG_RAW == "" -%}
    {%- if CAL_QUIET[ci] != "true" -%}{%- assign keep = true -%}{%- endif -%}
  {%- else -%}
    {%- for a in AG_LIST -%}{%- assign a_s = a | strip -%}{%- if a_s == ev.calname -%}{%- assign keep = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
  {%- endif -%}
  {%- unless keep -%}{%- continue -%}{%- endunless -%}
  {%- assign start_d = ev.start_full | split: "T" | first -%}
  {%- assign end_d = ev.end_full | split: "T" | first -%}
  {%- assign last_d = start_d -%}
  {%- if ev.all_day and end_d != blank and end_d > start_d -%}
    {%- assign last_d = end_d | date: "%s" | minus: 86400 | date: "%Y-%m-%d" -%}
  {%- endif -%}
  {%- if ev.all_day -%}
    {%- if last_d < today -%}{%- continue -%}{%- endif -%}
  {%- elsif start_d < today -%}
    {%- continue -%}
  {%- endif -%}
  {%- assign n_inc = n_inc | plus: 1 -%}
{%- endfor -%}
{%- assign split_at = n_inc | plus: 1 | divided_by: 2 -%}
{%- if AG_COLS == 1 -%}{%- assign split_at = 0 -%}{%- endif -%}

<style>
  .ag-wrap { display: flex; flex-direction: column; width: 100%; align-self: flex-start; overflow: hidden; }
  .ag-cols { display: flex; flex: 0 0 {{ AG_BUDGET }}px; overflow: hidden; }
  .ag-col { flex: 0 0 {{ AG_COL_W }}px; display: flex; flex-direction: column; overflow: hidden; }
  .ag-col + .ag-col { border-left: 1px dotted currentColor; }
  .ag-gap { flex: 0 0 {{ AG_GAP_H }}px; }
  .ag-month { display: flex; align-items: center; flex: 0 0 {{ AG_HEAD_H }}px; }
  .ag-row { display: flex; align-items: center; flex: 0 0 {{ AG_ROW_H }}px; white-space: nowrap; overflow: hidden; }
  .ag-date { flex: 0 0 {{ AG_DATE_CHARS | times: CHAR_W100 | divided_by: 100 | plus: 4 }}px; }
  .ag-time { flex: 0 0 {{ AG_TIME_CHARS | times: CHAR_W100 | divided_by: 100 | plus: 4 }}px; }
  .ag-text { flex: 1 1 auto; min-width: 0; }
  /* No flex-distribution keyword here: trmnlp's lint counts its name.
     The first span grows, which pushes the "+N more" to the right edge. */
  .ag-foot { display: flex; align-items: center; height: {{ AG_ROW_H }}px; border-top: 1px dotted currentColor; }
  .ag-foot > :first-child { flex: 1 1 auto; }
  .ag-swatch { display: inline-block; width: 8px; height: 8px; flex: 0 0 8px; }
  .ag-line { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: bold; line-height: var(--cg-line-h); --ui-scale: 0; }
</style>

<div class="view view--{{ VIEW }}">
  <div class="layout">
    <div class="ag-wrap px--1" data-ag-chars="{{ AG_ROW_CHARS }}" data-ag-budget="{{ AG_BUDGET }}" data-ag-cols="{{ AG_COLS }}" data-ag-split="{{ split_at }}" style="--cg-line-h:{{ LINE_H }}px">
      <div class="ag-cols">
      <div class="ag-col" data-col="1">
      {%- assign y = 0 -%}
      {%- assign col = 1 -%}
      {%- assign cur_month = "" -%}
      {%- assign last_date = "" -%}
      {%- assign shown = 0 -%}
      {%- assign more = 0 -%}
      {%- assign full = false -%}
      {%- for ev in events -%}
        {%- assign ci = 0 -%}
        {%- for c in cals -%}{%- if c == ev.calname -%}{%- assign ci = forloop.index0 -%}{%- break -%}{%- endif -%}{%- endfor -%}
        {%- comment -%} the calendar filter: the named ones, or every calendar that is not quiet {%- endcomment -%}
        {%- assign keep = false -%}
        {%- if AG_RAW == "" -%}
          {%- if CAL_QUIET[ci] != "true" -%}{%- assign keep = true -%}{%- endif -%}
        {%- else -%}
          {%- for a in AG_LIST -%}{%- assign a_s = a | strip -%}{%- if a_s == ev.calname -%}{%- assign keep = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
        {%- endif -%}
        {%- unless keep -%}{%- continue -%}{%- endunless -%}

        {%- assign start_d = ev.start_full | split: "T" | first -%}
        {%- assign end_d = ev.end_full | split: "T" | first -%}
        {%- assign last_d = start_d -%}
        {%- if ev.all_day and end_d != blank and end_d > start_d -%}
          {%- assign last_d = end_d | date: "%s" | minus: 86400 | date: "%Y-%m-%d" -%}
        {%- endif -%}
        {%- if ev.all_day -%}
          {%- if last_d < today -%}{%- continue -%}{%- endif -%}
        {%- elsif start_d < today -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign anchor_d = start_d -%}
        {%- if anchor_d < today -%}{%- assign anchor_d = today -%}{%- endif -%}
        {%- assign month_key = anchor_d | slice: 0, 7 -%}

        {%- comment -%} the row's three cells {%- endcomment -%}
        {%- if last_d > start_d -%}
          {%- assign d_from = start_d | date: "%-m/%-d" -%}
          {%- if start_d < today -%}{%- assign d_from = "now" -%}{%- endif -%}
          {%- assign date_txt = last_d | date: "%-m/%-d" | prepend: "-" | prepend: d_from -%}
        {%- elsif start_d == today -%}
          {%- assign date_txt = "Today" -%}
        {%- else -%}
          {%- assign date_txt = start_d | date: "%a %-m/%-d" -%}
        {%- endif -%}
        {%- if ev.all_day -%}
          {%- assign time_txt = "" -%}
        {%- else -%}
          {%- assign sp = ev.start | split: " " -%}
          {%- assign time_txt = sp[0] | append: sp[1] | downcase -%}
        {%- endif -%}
        {%- assign text = ev.summary -%}
        {%- comment -%} Google sends the whole postal address; the venue is the part before the first comma {%- endcomment -%}
        {%- if VIEW == "full" and ev.location != blank -%}
          {%- assign venue = ev.location | split: "," | first | strip -%}
          {%- assign text = text | append: " · " | append: venue -%}
        {%- endif -%}
        {%- assign text = text | truncate: AG_TITLE_CHARS -%}

        {%- comment -%}
          Column break: at the balanced split, or when the column is full.
          A row that continues a month at the top of a new column repeats
          the month header, so the column reads on its own.
        {%- endcomment -%}
        {%- if col < AG_COLS -%}
          {%- assign need = AG_ROW_H -%}
          {%- if month_key != cur_month -%}{%- assign need = need | plus: AG_HEAD_H | plus: AG_GAP_H -%}{%- endif -%}
          {%- assign after = y | plus: need -%}
          {%- if shown == split_at or after > AG_BUDGET -%}
            {%- assign col = col | plus: 1 -%}
            {%- assign y = 0 -%}
            {%- assign cur_month = "" -%}
            {%- assign last_date = "" -%}
      </div>
      <div class="ag-col" data-col="{{ col }}">
          {%- endif -%}
        {%- endif -%}
        {%- assign need = AG_ROW_H -%}
        {%- if month_key != cur_month -%}
          {%- assign need = need | plus: AG_HEAD_H -%}
          {%- if y > 0 -%}{%- assign need = need | plus: AG_GAP_H -%}{%- endif -%}
        {%- endif -%}
        {%- assign after = y | plus: need -%}
        {%- if full or after > AG_BUDGET -%}
          {%- assign full = true -%}
          {%- assign more = more | plus: 1 -%}
          {%- continue -%}
        {%- endif -%}
        {%- if month_key != cur_month -%}
          {%- if y > 0 -%}<div class="ag-gap"></div>{%- endif -%}
          {%- assign cur_month = month_key -%}
          {%- assign last_date = "" -%}
          <div class="ag-month bg--black px--1" data-month="{{ month_key }}" data-col="{{ col }}">
            <span class="label label--small ag-line text--white">{{ anchor_d | date: "%B %Y" }}</span>
          </div>
        {%- endif -%}
        {%- comment -%} a second event on the same day leaves the date cell blank, so the day reads as one group {%- endcomment -%}
        {%- if date_txt == last_date -%}{%- assign date_show = "" -%}{%- else -%}{%- assign date_show = date_txt -%}{%- endif -%}
        {%- assign last_date = date_txt -%}
        <div class="ag-row" data-month="{{ month_key }}" data-date="{{ date_txt }}" data-cal="{{ ev.calname }}" data-text="{{ text | escape }}" data-col="{{ col }}">
          <span class="ag-swatch bg--{{ CAL_TOKENS[ci] }}"></span>
          <span class="ag-date px--1"><span class="label label--small ag-line">{{ date_show }}</span></span>
          <span class="ag-time"><span class="label label--small ag-line">{{ time_txt }}</span></span>
          <span class="ag-text"><span class="label label--small ag-line">{{ text }}</span></span>
        </div>
        {%- assign y = after -%}
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
      {%- if shown == 0 -%}
        <div class="ag-row" data-empty="true">
          <span class="ag-text"><span class="label label--small ag-line">Nothing out of the routine through {{ HORIZON_LAST }}</span></span>
        </div>
      {%- endif -%}
      </div>
      </div>
      <div class="ag-foot">
        <span class="label label--small ag-line">through {{ HORIZON_LAST }}</span>
        {%- if more > 0 -%}<span class="label label--small ag-line" data-more="{{ more }}">+{{ more }} more</span>{%- endif -%}
      </div>
    </div>
  </div>
</div>
